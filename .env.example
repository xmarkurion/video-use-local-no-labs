# Local transcription (the default backend) needs no keys at all.
# Both of these are optional.

# Speaker diarization with pyannote. Accept the model terms once at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# then paste a read token from https://huggingface.co/settings/tokens
HF_TOKEN=

# Only for --backend elevenlabs (hosted Scribe fallback / A-B comparison).
ELEVENLABS_API_KEY=
